# ============================================================
# 禅道 Bug 自动修复闭环系统 —— 配置文件（本文件含密码，勿提交版本库）
# 复制 .env.example 为 .env 后填写真实值；改完到 Web「配置」页点“重新读取 .env”
# ============================================================

# ---- 禅道 ----
ZENTAO_BASE_URL=
ZENTAO_ACCOUNT=
ZENTAO_PASSWORD=
# 留空 = 自动获取该账号有权限的全部产品；也可以写成 1,3,7 只同步指定产品
ZENTAO_PRODUCT_IDS=
ZENTAO_BUG_STATUS=active
ZENTAO_BROWSE_TYPE=assigntome
ZENTAO_VERIFY_SSL=false
ZENTAO_TIMEOUT=20
# 若你的禅道版本评论接口路径不同，在这里覆盖，占位符为 {bug_id}
ZENTAO_COMMENT_PATH=
# 登录接口路径（默认 /api.php/v1/tokens）
ZENTAO_TOKENS_PATH=/api.php/v1/tokens
# 手工令牌：填了则跳过账号密码登录（用于账号锁定 / 强制图形验证码的情况）
ZENTAO_TOKEN=
# 认证通道：rest=api.php 换 token；session=模拟浏览器登录 + /xxx.json 内部接口
#          cookie=复用浏览器 zentaosid；auto=cookie→rest（绝不自动发密码）
# api.php 被统一登录网关拦截（返回 {"errcode":401,"errmsg":"缺少code参数"}）时用 session
ZENTAO_AUTH_MODE=auto
# session/cookie 模式下的会话 cookie（ZENTAO_COOKIE=...）
ZENTAO_COOKIE=

# ---- SVN（默认方式下本系统不执行 svn：提交由目标代码库自己的提交细则负责）----
# 下面的配置只用于两件事：1) 闸门 G3 判断这条 bug 属于哪份代码 + 审查页展示归属
#                       2) 你允许本系统代跑 svn 时的「可选方式」（bind-repo 建分支/提交）
# 一个禅道产品 = 一个代码库；各产品自己的仓库请用
#   python -m app.cli bind-repo <产品ID> <仓库根地址> --name "产品名" --build "..." --test "..."
# 或 Web「产品仓库」页 /repos 绑定，绑定关系存在 product_repos 表
SVN_REPO_URL=
SVN_WORKING_COPY=
SVN_TRUNK_PATH=/trunk
SVN_BRANCH_ROOT=/branches
SVN_USERNAME=
SVN_PASSWORD=
SVN_BIN=svn
# 安全开关：保持 false，AI 绝不允许提交/合并到 trunk
SVN_ALLOW_TRUNK_WRITE=false
# 主人侧「推入 SVN」用的稀疏工作副本根目录（在编译服务器上，AUTO_LOOP.md §3.3）。
# 留空 = 取该镜像 ssh.remote_workspace 上一级的 svn_promote/<镜像目录名>。
SVN_PROMOTE_ROOT=

# ---- 多语言直连通道（闸门 G12，AUTO_LOOP.md §2.1）----
# 词条文件攒着不提交必然冲突，而新增词条对版本没有影响 → 单独提交、改前先 up、改完立即 ci。
# false = 关掉这条例外，i18n-up / i18n-commit 都会被拒绝（词条就得回镜像等主人回灌）。
I18N_DIRECT_SVN_COMMIT=true
# 白名单（逗号分隔，命中才允许走直连通道）：文件名词或路径式均可，如 *.po,*.mo,locale/*.json
I18N_FILE_PATTERNS=*.po,*.mo,*.pot,*.qm
# 正式 SVN 工作副本按产品配置（多语言通道的唯一可写目录）：
#   python -m app.cli bind-repo <产品ID> "<SVN仓库地址>" --working-copy <镜像目录> --svn-working-copy <正式SVN工作副本>

# ---- Web 服务 / AI 执行器 ----
WEB_HOST=127.0.0.1
WEB_PORT=5000
DB_PATH=
AI_BATCH_SIZE=5
# true = commit 之前必须先写入分析结论（analyze 或 commit --root-cause/--impact/...），
#        否则 commit 直接报错；审查页靠这份分析判断质量
REQUIRE_ANALYSIS=true
# 暂时失败不许中止任务：读类请求（禅道列表/详情/附件）遇到 429、5xx、连不上时
# 等 RETRY_WAIT 秒重试，总共试 RETRY_MAX 次；写类动作（评论、i18n-commit）刻意不重试
RETRY_WAIT=300
RETRY_MAX=3
# 被 claim 后超过这么多分钟没回音的 bug 会自动回到队列（queue_kind=stale），
# 跑挂的那一轮不会把任务永久卡在 fixing；0 = 关闭回收
STALE_CLAIM_MINUTES=40
# 分支名 = 前缀 + 禅道ID（各产品可在 product_repos.branch_prefix 单独覆盖）
BRANCH_PREFIX=bugfix/zentao-
